# Long-cache immutable hashed assets produced by Vite
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The logo / static root assets. Short TTL (5 min) so logo swaps
# propagate to the edge within minutes instead of waiting up to 24h
# for the old asset to fall out of Cloudflare's CDN cache. Static root
# assets change rarely but never get a content hash (they're referenced
# by stable paths like /Synther.svg), so we can't use the "immutable"
# trick that /assets/* gets from Vite.
/*.svg
  Cache-Control: public, max-age=300

# HTML should always revalidate
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
